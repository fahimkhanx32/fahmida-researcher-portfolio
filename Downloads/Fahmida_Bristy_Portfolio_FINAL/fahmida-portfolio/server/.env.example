# Copy this file to ".env" and fill it in. Never commit ".env".

# --- Database (MongoDB Atlas) ---------------------------------------------------------
# Replace <db_password> with the password of your Atlas database user (Atlas -> Database Access).
# If the password has special characters (@ : / ? # %) URL-encode them, e.g. @ becomes %40.
# The name after ".net/" is the database this site will use; it is created automatically.
MONGODB_URI=mongodb+srv://bristyfahmida34_db_user:<db_password>@cluster0.xe8ysud.mongodb.net/fahmida_portfolio?retryWrites=true&w=majority&appName=Cluster0

# --- Server -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Where the website runs (comma-separated if several). In production with one server, use your site address.
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# 32+ random characters used to sign login cookies. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SAMESITE=lax

# --- Owner account (created on first start; you can delete ADMIN_PASSWORD afterwards) ----
# First login name (defaults to ADMIN_EMAIL). Can be changed later in the dashboard.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Dr. Fahmida Bristy

# --- Cloudinary (photo, CV and project images) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- E-mail (password reset + "new message" alerts). Optional: without it, e-mails print in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dr. Fahmida Bristy <no-reply@yourdomain.com>"
NOTIFY_EMAIL=
